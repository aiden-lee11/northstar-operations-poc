{
  "name": "northstar-operations-poc",
  "version": "1.0.0",
  "private": true,
  "description": "Local synthetic Northstar operations demonstration",
  "type": "module",
  "scripts": {
    "build": "vite build --config frontend/vite.config.ts",
    "dev": "vite build --watch --config frontend/vite.config.ts",
    "typecheck": "tsc --noEmit --project frontend/tsconfig.json",
    "test": "vitest run --config frontend/vite.config.ts",
    "test:watch": "vitest --config frontend/vite.config.ts"
  },
  "dependencies": {
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "jsdom": "26.1.0",
    "typescript": "5.9.2",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
